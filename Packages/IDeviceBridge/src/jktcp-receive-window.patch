+    /// Segments that came after a gap, by sequence number, until the gap
+    /// is filled: in place of dropping them, so one lost segment costs one
+    /// retransmission.
+    held: Vec<(u32, Vec<u8>)>,
 }
 
 #[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]
@@ -116,6 +127,49 @@ impl ConnectionState {
             bytes_in_flight: 0,
             peer_window: 0,
             peer_wscale: None,
+            held: Vec::new(),
+        }
+    }
+
+    /// The window field of our segments: [`RECV_WINDOW`], scaled when the
+    /// peer agreed to window scaling.
+    fn advertised_window(&self) -> u16 {
+        match self.peer_wscale {
+            Some(_) => (RECV_WINDOW >> OUR_WSCALE).min(u16::MAX as u32) as u16,
+            None => RECV_WINDOW.min(u16::MAX as u32 - 1) as u16,
+        }
+    }
+
+    /// Holds a segment that came after a gap, if it's within the window and
+    /// isn't held already.
+    fn hold(&mut self, seq: u32, payload: &[u8]) {
+        let ahead = seq.wrapping_sub(self.ack) as usize;
+        if ahead + payload.len() > RECV_WINDOW as usize {
+            return;
+        }
+        if self.held.iter().any(|(held, data)| *held == seq && data.len() >= payload.len()) {
+            return;
+        }
+        let holding: usize = self.held.iter().map(|(_, data)| data.len()).sum();
+        if holding + payload.len() > RECV_WINDOW as usize {
+            return;
+        }
+        self.held.push((seq, payload.to_vec()));
+    }
+
+    /// Moves the held segments that now follow on from `ack` into the read
+    /// buffer, and drops the ones received in full already.
+    fn take_held(&mut self) {
+        loop {
+            let ack = self.ack;
+            self.held.retain(|(seq, data)| seq_lt(ack, seq.wrapping_add(data.len() as u32)));
+            let Some(next) = self.held.iter().position(|(seq, _)| seq_lte(*seq, ack)) else {
+                break;
+            };
+            let (seq, data) = self.held.swap_remove(next);
+            let skip = ack.wrapping_sub(seq) as usize;
+            self.read_buffer.extend_from_slice(&data[skip..]);
+            self.ack = seq.wrapping_add(data.len() as u32);
         }
     }
 }
